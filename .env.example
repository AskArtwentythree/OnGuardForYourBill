# ---------- TrueForge ----------
# Where your TrueForge server runs (npx local mode default).
TRUEFORGE_BASE_URL=http://localhost:8790
# Only needed when OIDC login is enabled on TrueForge.
# TRUEFORGE_TOKEN=
# Model FQN the agent runs on. Configure the provider in TrueForge Settings -> Models first.
TRUEFORGE_MODEL=openai/gpt-4o-mini
# Set to false to run without a Daytona sandbox (skills + sandbox estimator disabled).
SANDBOX_ENABLED=true

# ---------- OnGuardForYourBill gateway ----------
GATEWAY_PORT=8788
# The MCP URL from TrueForge's point of view. Docker compose -> http://host.docker.internal:8788/mcp
GATEWAY_MCP_URL=http://localhost:8788/mcp
# Key for the PAID benchmark provider (execute_case). Lives ONLY here — never in the agent.
# Leave unset to demo with the free deterministic 'mock' provider.
# PROVIDER_API_KEY=sk-...
# PROVIDER_BASE_URL=https://api.openai.com/v1
# HMAC key for signing budget grants. Change it.
GRANT_SIGNING_KEY=change-me-to-a-long-random-string
# Gemini (for the "$137 overnight" demo). With a real key, remove it from FAKE_PROVIDERS.
# GEMINI_API_KEY=...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comma-separated providers to SIMULATE with the deterministic mock backend:
# full estimate/approval/grant/ledger flow, zero real spend. Great for filming
# "approve $137 for Gemini" without a Gemini bill.
FAKE_PROVIDERS=gemini
# Optional control-plane proxy upstream (meters the harness's own tokens).
# CONTROL_PLANE_API_KEY=sk-...
# CONTROL_PLANE_UPSTREAM=https://api.openai.com/v1

# ---------- Approval relay ----------
RELAY_PORT=8789
GATEWAY_URL=http://localhost:8788
AGENT_NAME=overnight-eval-operator
# Shared secret in phone action URLs. Change it.
WEBHOOK_TOKEN=change-me-too
# URL your PHONE can reach the relay at. Defaults to your LAN IP (same Wi-Fi).
# Use a tunnel (e.g. `ngrok http 8789`) if phone and laptop are on different networks.
# PUBLIC_RELAY_URL=https://your-tunnel.ngrok.app

# ---------- Phone notifications (ntfy.sh) ----------
# Pick a LONG RANDOM topic (it acts as a password) and subscribe to it in the
# ntfy app (iOS/Android). Example: onguard-a8f3k2j9x7q1
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# ---------- Skill (optional, after you push this repo to GitHub) ----------
# SKILL_REPO_URL=https://github.com/YOUR_USER/onguard-for-your-bill
# SKILL_REF=main
